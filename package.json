{
    "name": "@distribution/maths",
    "version": "1.0.0",
    "description": "Maths distribution - Vite + React app deployable to GitHub Pages",
    "type": "module",
    "main": "src/main.tsx",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "deploy": "vite build && gh-pages -d dist"
    },
    "author": "NQQT",
    "license": "ISC",
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "@react/headless": "*",
        "@presource/core": "*",
        "@presource/react": "*",
        "@mui/material": "^5.18.0",
        "@emotion/react": "^11.11.0",
        "@emotion/styled": "^11.11.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "gh-pages": "^6.3.0",
        "jsdom": "^29.0.2",
        "typescript": "^6.0.0",
        "vite": "^8.0.8",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.4"
    }
}
